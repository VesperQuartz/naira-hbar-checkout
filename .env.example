# Local Postgres from docker-compose.yml (copy to .envrc or .env)
export DATABASE_URL=postgresql://postgres:postgres@localhost:5433/naira_hbar_checkout
export BETTER_AUTH_SECRET=
export BETTER_AUTH_URL=
export VITE_PUBLIC_API_URL=

# Naira demo rate: fixed figure used to show ₦ prices (not a live FX rate)
export DEMO_NGN_PER_USD=1500

# Hedera network and deploy-script operator (never commit real keys)
export HEDERA_NETWORK=testnet
export HEDERA_OPERATOR_ID=
export HEDERA_OPERATOR_PRIVATE_KEY=

# Chainlink HBAR/USD data feed (Hedera-specific address, not an Ethereum one)
export CHAINLINK_HBAR_USD_FEED=

# JSON-RPC endpoint used to read that feed off-chain for quotes.
# Optional — defaults to Hashio for HEDERA_NETWORK (testnet/mainnet).
export CHAINLINK_RPC_URL=

# Deployed CheckoutRouter EVM address — printed by `forge script ... --broadcast`
# and required by `pnpm --filter @repo/orpc proof`
export CHECKOUT_CONTRACT_ADDRESS=

# CheckoutRouter deploy tunables (defaults shown; safe to omit)
export PRICE_TOLERANCE_BPS=500
export MAX_PRICE_AGE_SECONDS=86400

# HCS topic that receives one receipt message per payment
export HCS_TOPIC_ID=

# SaucerSwap swap and merchant settlement (HTS stablecoin)
export SAUCERSWAP_ROUTER=
export STABLECOIN_TOKEN_ID=
export MERCHANT_ACCOUNT_ID=

# EVM payout address for CheckoutRouter (0x…). The 0.0.x account id above is
# NOT an EVM address — copy the account's 0x address here for the contract.
export MERCHANT_EVM_ADDRESS=
